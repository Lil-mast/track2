# --- AWS Credentials ---
# For local development only. In production, use IAM roles or temporary credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_SESSION_TOKEN=your_session_token  # Optional: for temporary credentials

# --- Aurora Database (Data API) ---
AURORA_CLUSTER_ARN=arn:aws:rds:region:account-id:cluster/cluster-name
AURORA_SECRET_ARN=arn:aws:secretsmanager:region:account-id:secret:secret-name
AURORA_DATABASE=recoveryai

# --- Environment ---
NODE_ENV=development
