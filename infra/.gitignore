# ============================================================
# CDK / infra — keep the public repo clean of build artifacts
# and anything that could contain account-specific or secret data.
# ============================================================

# CDK synthesized output — may contain account IDs, ARNs, and
# resolved template values. NEVER commit this.
cdk.out/
*.cdk.staging/
cdk.context.json

# Compiled TypeScript
*.js
*.d.ts
!jest.config.js

# Dependencies
node_modules/

# TypeScript build info
*.tsbuildinfo

# Local env / credentials — never commit
.env
.env.*
*.pem

# Deploy logs (may echo outputs / ARNs)
*.log
deploy-output*.txt
outputs*.json
